---
import Icon from './icon/Icon.astro'
import type { PersonalInfo } from '../lib/content-types'

interface Props {
  personalInfo: PersonalInfo
  className?: string
}

const { personalInfo, className = '' } = Astro.props
---

<div class={`w-full mb-6 lg:mb-0 mx-auto relative bg-white text-center dark:bg-dark-primary px-6 rounded-[20px] mt-[180px] md:mt-[220px] lg:mt-0 ${className}`}>
  <img
    src="/assets/portrait.webp"
    class="absolute left-[50%] transform -translate-x-[50%] drop-shadow-xl mx-auto rounded-[20px] -mt-[140px]"
    alt="about"
    width={240}
    height={240}
  />
  <div class="pt-[100px] pb-8">
    <h2 class="heading mt-6 mb-1 text-[26px] font-semibold font-jetbrains">
      {personalInfo.information.name}
    </h2>
    <h3 class="mb-4 text-light-text inline-block dark:bg-dark-mobile-primary px-5 py-1.5 rounded-lg dark:text-main-text">
      {personalInfo.information.profession}
    </h3>
    <div class="flex justify-center space-x-3">
      {personalInfo.information.socialMedia.github && (
        <a
          href={personalInfo.information.socialMedia.github}
          aria-label="Github Profile Link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="flex items-center justify-center w-10 h-10 transition-all duration-300 ease-in-out rounded-lg bg-light-bg-five dark:bg-dark-border hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary hover:text-white text-fb-icon">
            <Icon name="GitHub" />
          </span>
        </a>
      )}

      {personalInfo.information.socialMedia.gitlab && (
        <a
          href={personalInfo.information.socialMedia.gitlab}
          aria-label="Gitlab Profile Link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="flex items-center justify-center w-10 h-10 transition-all duration-300 ease-in-out rounded-lg bg-light-bg-five dark:bg-dark-border hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary hover:text-white text-fb-icon">
            <Icon name="GitLab" />
          </span>
        </a>
      )}

      {personalInfo.information.socialMedia.upwork && (
        <a
          href={personalInfo.information.socialMedia.upwork}
          aria-label="upwork Profile Link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="flex items-center justify-center w-10 h-10 font-bold transition-all duration-300 ease-in-out rounded-lg bg-light-bg-five dark:bg-dark-border hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary hover:text-white text-fb-icon">
            Up
          </span>
        </a>
      )}

      {personalInfo.information.socialMedia.linkedIn && (
        <a
          href={personalInfo.information.socialMedia.linkedIn}
          aria-label="LinkedIn Profile Link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="flex items-center justify-center w-10 h-10 transition-all duration-300 ease-in-out rounded-lg bg-light-bg-five dark:bg-dark-border hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary hover:text-white text-linkedin-icon">
            <Icon name="LinkedIn" />
          </span>
        </a>
      )}
    </div>
    <div class="p-7 rounded-2xl mt-7 bg-light-bg-five dark:bg-dark-mobile-primary">
      <div class="flex border-b border-light-border-two dark:border-dark-border-two pb-2.5">
        <span class="flex items-center justify-center w-10 h-10 transition-all duration-300 ease-in-out bg-white rounded-lg shadow-md hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary hover:text-white dark:bg-black text-icon-color-one">
          <Icon name="Star" />
        </span>
        <div class="text-left ml-2.5">
          <p class="text-xs text-text-primary dark:text-main-text">
            Experience
          </p>
          <p class="dark:text-white">
            {personalInfo.information.experience}
          </p>
        </div>
      </div>

      <div class="flex border-b border-light-border-two dark:border-dark-border-two py-2.5">
        <span class="flex items-center justify-center w-10 h-10 transition-all duration-300 ease-in-out bg-white rounded-lg shadow-md hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary hover:text-white dark:bg-black text-icon-color-two">
          <Icon name="MailOpen" />
        </span>
        <div class="text-left ml-2.5">
          <p class="text-xs text-text-primary dark:text-main-text">
            Email
          </p>
          <p class="dark:text-white">
            {personalInfo.information.email}
          </p>
        </div>
      </div>
      <div class="flex border-b border-light-border-two dark:border-dark-border-two py-2.5">
        <span class="flex items-center justify-center w-10 h-10 transition-all duration-300 ease-in-out bg-white rounded-lg shadow-md hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary hover:text-white dark:bg-black text-icon-color-three">
          <Icon name="Location" />
        </span>
        <div class="text-left ml-2.5">
          <p class="text-xs text-text-primary dark:text-main-text">
            Location
          </p>
          <p class="dark:text-white">
            {personalInfo.information.location}
          </p>
        </div>
      </div>
      <div class="flex py-2.5">
        <span class="flex items-center justify-center w-10 h-10 transition-all duration-300 ease-in-out bg-white rounded-lg shadow-md hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary hover:text-white dark:bg-black text-icon-color-four">
          <Icon name="Calendar" />
        </span>
        <div class="text-left ml-2.5">
          <p class="text-xs text-text-primary dark:text-main-text">
            Birthday
          </p>
          <p class="dark:text-white">
            {personalInfo.information.birthday}
          </p>
        </div>
      </div>
    </div>
    <button class="flex items-center text-lg text-white transition-all ease-in-out duration-200 mt-6 mx-auto px-8 py-3 rounded-[35px] bg-gradient-to-r from-btn-secondary to-btn-primary hover:bg-gradient-to-r hover:from-btn-primary hover:to-btn-secondary">
      <span class="mr-3">
        <Icon name="Download" size={20} />
      </span>
      <a href="/assets/Robert Weeden Resume July 2024.pdf" download aria-label="Download resume">
        Download Resume
      </a>
    </button>
  </div>
</div>
