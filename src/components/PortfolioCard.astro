---
import Icon from "./icon/Icon.astro"
import type { Portfolio } from "../lib/content-types"

interface Props {
  details: Portfolio
  className?: string
}

const { details, className = "" } = Astro.props
---

<div class={`rounded-lg bg-light-bg-five p-6 dark:bg-transparent dark:border-[2px] border-dark-border ${className}`}>
  <div class="overflow-hidden rounded-lg">
    <a href={details.link}>
      <img
        class="w-full h-auto transition duration-200 ease-in-out transform rounded-lg cursor-pointer hover:scale-110"
        src={details.img}
        alt="portfolio image"
      />
    </a>
  </div>
  <span class="pt-5 text-[14px] font-normal text-text-primary block dark:text-main-text">
    {details.category}
  </span>

  <h2 class="heading mt-2 text-xl font-medium transition duration-300 cursor-pointer hover:text-btn-primary dark:hover:text-btn-primary">
    <a href={details.link}>{details.title}</a>
  </h2>

  <details class="mt-4">
    <summary class="cursor-pointer text-text-primary dark:text-white hover:text-btn-primary">
      View Details
    </summary>
    <div class="mt-4 space-y-4">
      <h3 class="text-2xl font-bold text-modal-text dark:text-white">
        {details.modal.title}
      </h3>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="space-y-2">
          <p class="dark:text-white flex text-[15px] sm:text-base">
            <span class="min-w-16 text-modal-text">Project:&nbsp;</span>
            <span class="font-medium">
              {details.modal.project}
            </span>
          </p>
          <p class="dark:text-white flex text-[15px] sm:text-base">
            <span class="min-w-16 text-modal-text">Tools:&nbsp;</span>
            <span class="flex flex-wrap gap-2">
              {details.modal.languages.split(",").map(tool => (
                <span class="px-1.5 py-0.5 font-medium text-sm border rounded-full border-codeBlue">
                  {tool}
                </span>
              ))}
            </span>
          </p>
        </div>

        <div class="space-y-2">
          <p class="dark:text-white flex mt-2 lg:mt-0 text-[15px] sm:text-base">
            <span class="min-w-16 text-modal-text">Client:&nbsp;</span>
            <span class="font-medium">{details.modal.client}</span>
          </p>
          <p class="dark:text-white flex text-[15px] sm:text-base">
            <span class="min-w-16 text-modal-text">Preview:&nbsp;</span>
            <span class="font-medium transition-all duration-300 ease-in-out hover:text-modal-text">
              <a
                href={details.modal.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center"
              >
                {details.modal.preview}
                <Icon name="Link" className="pl-2" />
              </a>
            </span>
          </p>
        </div>
      </div>

      <p class="text-sm font-normal dark:text-white sm:text-base">
        {details.modal.description}
      </p>

      <div>
        <img
          class="object-cover w-auto h-auto mt-6 rounded-xl"
          src={details.modal.img}
          alt="portfolio image"
        />
      </div>
    </div>
  </details>
</div>
