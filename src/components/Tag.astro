---
interface Props {
  tagName: string
  className?: string
}

const { tagName, className = '' } = Astro.props
---

<button class={`resume-btn cursor-default rounded-lg bg-light-bg-six pl-5 pr-5 pt-2 pb-2 text-text-primary dark:bg-dark-bg-two dark:text-main-text ${className}`}>
  {tagName}
</button>
