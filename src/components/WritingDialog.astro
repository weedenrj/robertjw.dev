---
interface Props {
  title: string
  date: string
  author: string
}

const { title, date, author } = Astro.props
---

<dialog
  id="writing-dialog"
  class="writing-dialog fixed inset-0 z-50 m-auto max-w-4xl w-full max-h-[90vh] bg-white dark:bg-dark-primary rounded-2xl shadow-2xl overflow-hidden backdrop:bg-black/50 backdrop:backdrop-blur-sm"
  data-astro-transition-scope="writing-dialog"
  data-astro-transition="animate"
>
  <div class="flex flex-col h-full max-h-[90vh]">
    <header class="flex-shrink-0 px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
      <div class="flex-1">
        <h2 class="heading text-2xl font-bold font-jetbrains mb-1">
          {title}
        </h2>
        <div class="flex gap-4 text-text-primary dark:text-main-text text-sm">
          <time>{date}</time>
          <span>by {author}</span>
        </div>
      </div>
      <form method="dialog">
        <button
          type="submit"
          class="ml-4 p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors"
          aria-label="Close dialog"
          data-close-dialog
        >
          <svg
            class="w-6 h-6 text-text-primary dark:text-main-text"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </form>
    </header>
    <div class="flex-1 overflow-y-auto px-6 py-6">
      <slot />
    </div>
  </div>
</dialog>

<script>
  function openDialog() {
    const dialog = document.getElementById('writing-dialog') as HTMLDialogElement
    if (dialog) {
      dialog.showModal()
    }
  }

  function closeDialog() {
    const dialog = document.getElementById('writing-dialog') as HTMLDialogElement
    if (dialog) {
      dialog.close()
    }
  }

  function navigateToWritings() {
    if (window.location.pathname.startsWith('/writings/') && window.location.pathname !== '/writings') {
      window.history.pushState({}, '', '/writings')
      window.dispatchEvent(new PopStateEvent('popstate'))
    }
  }

  if (import.meta.env.SSR === false) {
    const initDialog = () => {
      const dialog = document.getElementById('writing-dialog') as HTMLDialogElement
      if (!dialog) return

      if (window.location.pathname.startsWith('/writings/') && window.location.pathname !== '/writings') {
        requestAnimationFrame(() => {
          openDialog()
        })
      } else {
        closeDialog()
      }

      const handleClose = () => {
        if (window.location.pathname.startsWith('/writings/') && window.location.pathname !== '/writings') {
          navigateToWritings()
        }
      }

      const existingHandler = (dialog as any).__closeHandler
      if (existingHandler) {
        dialog.removeEventListener('close', existingHandler)
      }
      dialog.addEventListener('close', handleClose)
      ;(dialog as any).__closeHandler = handleClose

      const closeButton = dialog.querySelector('[data-close-dialog]')
      if (closeButton) {
        closeButton.addEventListener('click', (e) => {
          e.preventDefault()
          closeDialog()
          setTimeout(() => {
            navigateToWritings()
          }, 50)
        })
      }

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          closeDialog()
          setTimeout(() => {
            navigateToWritings()
          }, 50)
        }
      })
    }

    initDialog()

    document.addEventListener('astro:page-load', () => {
      initDialog()
    })

    document.addEventListener('astro:after-swap', () => {
      initDialog()
    })
  }
</script>

<style>
  .writing-dialog::backdrop {
    animation: fadeIn 0.3s ease-out;
  }

  .writing-dialog[open] {
    animation: slideUp 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 768px) {
    .writing-dialog {
      max-width: 100%;
      max-height: 100vh;
      border-radius: 0;
      margin: 0;
    }

    .writing-dialog[open] {
      animation: slideUpMobile 0.3s ease-out;
    }

    @keyframes slideUpMobile {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }
  }
</style>
