---
interface Props {
  title: string;
  date: string;
  author: string;
  note: string;
}

const { title, date, author, note } = Astro.props;
---

<dialog
  id="writing-dialog"
  class="writing-dialog fixed inset-0 z-50 m-auto max-h-[90vh] w-full max-w-4xl overflow-hidden rounded-2xl bg-white shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm dark:bg-dark-primary"
  data-astro-transition-scope="writing-dialog"
  data-astro-transition="animate"
>
  <div class="flex h-full max-h-[90vh] flex-col">
    <header
      class="flex flex-shrink-0 items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-gray-700"
    >
      <div class="flex-1">
        <h2 class="mb-1 font-jetbrains text-2xl font-bold heading">
          {title}
        </h2>
        <div class="flex gap-4 text-sm text-text-primary dark:text-main-text">
          <time>{date}</time>
          <span>by {author}</span>
        </div>
      </div>
      <form method="dialog">
        <button
          type="submit"
          class="ml-4 rounded-lg p-2 transition-colors hover:bg-gray-100 dark:hover:bg-gray-800"
          aria-label="Close dialog"
          data-close-dialog
        >
          <svg
            class="h-6 w-6 text-text-primary dark:text-main-text"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </form>
    </header>
    <div class="flex-1 overflow-y-auto px-6 py-6">
      {
        note.trim() && (
          <div class="mb-6 rounded-lg border-l-4 border-blue-500 bg-gray-100 p-4 dark:bg-gray-800">
            <p class="text-sm italic text-text-primary dark:text-main-text">
              <strong class="font-semibold">Note:</strong> {note}
            </p>
          </div>
        )
      }
      <slot />
    </div>
  </div>
</dialog>

<script>
  function openDialog() {
    const dialog = document.getElementById(
      "writing-dialog",
    ) as HTMLDialogElement;
    if (dialog) {
      dialog.showModal();
    }
  }

  function closeDialog() {
    const dialog = document.getElementById(
      "writing-dialog",
    ) as HTMLDialogElement;
    if (dialog) {
      dialog.close();
    }
  }

  function navigateToWritings() {
    if (
      window.location.pathname.startsWith("/writings/") &&
      window.location.pathname !== "/writings"
    ) {
      window.history.pushState({}, "", "/writings");
      window.dispatchEvent(new PopStateEvent("popstate"));
    }
  }

  if (import.meta.env.SSR === false) {
    const initDialog = () => {
      const dialog = document.getElementById(
        "writing-dialog",
      ) as HTMLDialogElement;
      if (!dialog) return;

      if (
        window.location.pathname.startsWith("/writings/") &&
        window.location.pathname !== "/writings"
      ) {
        requestAnimationFrame(() => {
          openDialog();
        });
      } else {
        closeDialog();
      }

      const handleClose = () => {
        if (
          window.location.pathname.startsWith("/writings/") &&
          window.location.pathname !== "/writings"
        ) {
          navigateToWritings();
        }
      };

      const existingHandler = (dialog as any).__closeHandler;
      if (existingHandler) {
        dialog.removeEventListener("close", existingHandler);
      }
      dialog.addEventListener("close", handleClose);
      (dialog as any).__closeHandler = handleClose;

      const closeButton = dialog.querySelector("[data-close-dialog]");
      if (closeButton) {
        closeButton.addEventListener("click", (e) => {
          e.preventDefault();
          closeDialog();
          setTimeout(() => {
            navigateToWritings();
          }, 50);
        });
      }

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) {
          closeDialog();
          setTimeout(() => {
            navigateToWritings();
          }, 50);
        }
      });
    };

    initDialog();

    document.addEventListener("astro:page-load", () => {
      initDialog();
    });

    document.addEventListener("astro:after-swap", () => {
      initDialog();
    });
  }
</script>

<style>
  .writing-dialog::backdrop {
    animation: fadeIn 0.3s ease-out;
  }

  .writing-dialog[open] {
    animation: slideUp 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 768px) {
    .writing-dialog {
      max-width: 100%;
      max-height: 100vh;
      border-radius: 0;
      margin: 0;
    }

    .writing-dialog[open] {
      animation: slideUpMobile 0.3s ease-out;
    }

    @keyframes slideUpMobile {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }
  }
</style>
