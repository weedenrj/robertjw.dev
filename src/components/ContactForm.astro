---
interface Props {
  className?: string
}

const { className = "" } = Astro.props
---

<div class={`mx-4 md:mx-[60px] p-4 md:p-16 dark:border-dark-border dark:border-2 bg-light-bg rounded-xl dark:bg-dark-primary mb-[30px] md:mb-[60px] ${className}`}>
  <h3 class="heading text-[1.5625rem]">
    <span class="text-text-primary dark:text-main-text">
      I'm always open to discussing
    </span>
    <br />
    <span class="font-semibold dark:text-white">
      application development and ideas.
    </span>
  </h3>

  <form
    action="mailto:robertweeden1997@gmail.com"
    method="get"
    class="mt-[40px]"
  >
    <input type="hidden" name="subject" id="subject" />

    <div class="relative z-0 w-full mt-[40px] mb-8 group">
      <input
        type="text"
        name="name"
        id="name"
        class="text-input peer"
        required
        autocomplete="name"
      />
      <label for="name" class="text-input-label">
        Name *
      </label>
    </div>

    <div class="relative z-0 w-full mb-8 group">
      <input
        type="email"
        name="email"
        id="email"
        class="text-input peer"
        required
        autocomplete="email"
      />
      <label for="email" class="text-input-label">
        Email *
      </label>
    </div>

    <div class="relative z-0 w-full mb-8 group">
      <textarea
        name="body"
        id="message"
        class="text-input peer"
        required
        rows="5"
      ></textarea>
      <label for="message" class="text-input-label">
        Message *
      </label>
    </div>

    <button
      type="submit"
      class="px-6 py-2 rounded-lg border-[2px] mt-3 border-color-910 font-semibold cursor-pointer hover:bg-gradient-to-r from-btn-primary to-btn-secondary hover:text-white transition-colors duration-300 ease-in-out hover:border-transparent dark:text-white"
    >
      Send email
    </button>
  </form>
</div>

<script>
  const form = document.querySelector('form')
  const subjectInput = document.getElementById('subject') as HTMLInputElement | null
  const nameInput = document.getElementById('name') as HTMLInputElement | null
  const emailInput = document.getElementById('email') as HTMLInputElement | null
  
  if (form && subjectInput && nameInput && emailInput) {
    form.addEventListener('submit', () => {
      const name = nameInput.value
      const email = emailInput.value
      if (name && email) {
        subjectInput.value = `Contact form submission from ${name} <${email}>`
      }
    })
  }
</script>
