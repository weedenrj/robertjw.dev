---
import Icon from "./icon/Icon.astro"
import type { MenuItem } from "../lib/content-types"
import type { IconName } from "../lib/icon-data"

interface Props {
  menuItems: MenuItem[]
  className?: string
}

const { menuItems, className = "" } = Astro.props
const pathname = Astro.url.pathname

const iconMapping: Record<string, IconName> = {
  FaUser: "User",
  FaBriefcase: "Building",
  FaWrench: "Wrench",
  FaBlogger: "PenToSquare",
  FaFileAlt: "DownloadFile",
  FaAddressBook: "AddressCard",
}

const filteredMenuItems = menuItems.filter((item) => item.enabled)
---

<header
  class={`lg:w-fit h-[144px] hidden lg:block p-[30px] ml-auto mb-10 rounded-[16px] bg-white dark:bg-dark-primary ${className}`}
>
  <nav class="hidden lg:block">
    <ul class="flex">
      {filteredMenuItems.map((item) => { 
            const iconName = iconMapping[item.icon] || "Home"
            const isActive = pathname === item.link
 
            return (
              <li>
                <a
                  class={`mx-2.5 flex h-20 w-20 cursor-pointer flex-col items-center justify-center rounded-[10px] bg-codeBlue bg-opacity-10 text-[0.8125rem] font-medium text-text-primary transition-all duration-300 ease-in-out dark:bg-dark-border dark:text-main-text ${
                    isActive
                      ? "bg-gradient-to-r from-btn-primary to-gradient-to !text-white"
                      : "hover:bg-gradient-to-r hover:from-btn-primary hover:to-gradient-to hover:text-white hover:dark:text-white"
                  }`}
                  href={item.link}
                >
                  <span class="mb-1 text-xl">
                    <Icon name={iconName} />
                  </span>
                  {item.name}
                </a>
              </li>
            )
          })
      }
    </ul>
  </nav>
</header>
