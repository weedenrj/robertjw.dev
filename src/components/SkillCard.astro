---
import type { Skill } from '../lib/content-types'
import Icon from './icon/Icon.astro'
import type { IconName } from '../lib/icon-data'

interface Props {
  skill: Skill
  className?: string
}

const { skill, className = '' } = Astro.props

const hexColorMatch = skill.iconColor.match(/#[0-9A-Fa-f]{6}/)
const hexColor = hexColorMatch ? hexColorMatch[0] : undefined
---

<div
  class={`flex gap-4 rounded-xl p-6 border-dark-border bg-opacity-20 dark:border-2 dark:bg-transparent ${skill.bgColor} ${className}`}
>
  <span class="block w-10 h-10 flex items-center justify-center">
    <Icon 
      name={skill.iconName as IconName} 
      size={40} 
      className={skill.iconColor} 
      {...(hexColor && { color: hexColor })} 
    />
  </span>
  <div class="space-y-2">
    <h3 class="heading text-[22px] font-semibold">
      {skill.skill}
    </h3>
    <p class="leading-8 text-text-primary dark:text-main-text">
      {skill.about}
    </p>
  </div>
</div>
