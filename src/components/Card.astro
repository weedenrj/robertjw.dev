---
import type { Education, Experience } from '../lib/content-types'

interface Props {
  details: Experience | Education
  className?: string
}

const { details, className = '' } = Astro.props
---

<div
  class={`${details.bgColor} dark:bg-transparent py-4 pl-5 pr-3 space-y-2 mb-6 rounded-lg dark:border-dark-border dark:border-2 ${className}`}
>
  <span class="text-tiny text-text-primary dark:text-dark-text">
    {details.year}
  </span>
  <h3 class="heading text-xl">{details.title}</h3>
  <p class="dark:text-dark-text">{details.subTitle}</p>
</div>
