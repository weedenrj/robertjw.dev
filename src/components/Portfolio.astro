---
import PortfolioCard from "./PortfolioCard.astro"
import type { Portfolio, PortfolioFilter } from "../lib/content-types"

interface Props {
  portfolio: Portfolio[]
  filters: PortfolioFilter[]
  className?: string
}

const { portfolio, filters, className = "" } = Astro.props
const activeFilter = Astro.url.searchParams.get('filter') || '*'
---

<style>
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }
</style>

<div class={`container mr-auto ml-auto mb-8 px-4 sm:px-5 md:px-10 lg:px-[60px] ${className}`}>
  <div class="py-12">
    <h2 class="heading relative inline-block text-[2.5rem] font-bold transform after:absolute after:md:w-[12rem] after:left-[14rem] after:h-0.5 after:bg-gradient-to-r after:from-btn-secondary after:to-btn-secondary after:content-[''] after:rounded-md after:top-2/4 after:transform">
      Portfolio
    </h2>
    <ul class="button-group isotop-menu-wrapper mt-[30px] flex w-full justify-start md:justify-end flex-wrap font-medium">
      {filters.map((filter) => {
        const filterUrl = filter.tag === '*' ? '/portfolio' : `/portfolio?filter=${encodeURIComponent(filter.tag)}`
        const isActive = filter.tag === activeFilter
        
        return (
          <li>
            <a
              href={filterUrl}
              data-filter={filter.tag}
              class={`filter-btn cursor-pointer transition-all duration-300 ease-in-out hover:text-btn-primary mr-4 md:mx-4 ${
                isActive ? '!text-btn-primary' : 'text-text-primary dark:text-main-text'
              }`}
            >
              {filter.name}
            </a>
          </li>
        )
      })}
    </ul>
  </div>

  <div class="portfolio-grid" id="portfolio-grid">
    {portfolio.map(item => (
      <div class="portfolio-item" data-tags={item.tags || ''} data-id={item.id}>
        <PortfolioCard details={item} />
      </div>
    ))}
  </div>
</div>

<script>
  import autoAnimate from '@formkit/auto-animate'
  
  const filter = new URLSearchParams(location.search).get('filter') || '*'
  const grid = document.getElementById('portfolio-grid')
  const links = document.querySelectorAll<HTMLElement>('.filter-btn')
  
  if (grid) {
    autoAnimate(grid)
    
    const allItems = Array.from(grid.querySelectorAll<HTMLElement>('.portfolio-item'))
    
    const updateFilter = (newFilter: string) => {
      allItems.forEach(item => {
        const tags = (item.getAttribute('data-tags') || '').toLowerCase()
        const shouldShow = newFilter === '*' || tags.includes(newFilter.toLowerCase())
        
        if (shouldShow && !grid.contains(item)) {
          grid.appendChild(item)
        } else if (!shouldShow && grid.contains(item)) {
          item.remove()
        }
      })
      
      links.forEach(link => {
        const isActive = link.getAttribute('data-filter') === newFilter
        if (isActive) {
          link.classList.add('!text-btn-primary')
          link.classList.remove('text-text-primary', 'dark:text-main-text')
        } else {
          link.classList.remove('!text-btn-primary')
          link.classList.add('text-text-primary', 'dark:text-main-text')
        }
      })
    }
    
    updateFilter(filter)
    
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const newFilter = link.getAttribute('data-filter') || '*'
        const url = newFilter === '*' ? '/portfolio' : `/portfolio?filter=${newFilter}`
        history.pushState({}, '', url)
        updateFilter(newFilter)
      })
    })
  }
</script>
