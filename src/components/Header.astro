---
import Icon from "./icon/Icon.astro"
import type { MenuQuery } from "../lib/content-types"
import type { IconName } from "../lib/icon-data"

interface Props {
  menuItems: MenuQuery
  className?: string
}

const { menuItems, className = "" } = Astro.props
const pathname = Astro.url.pathname

const iconMapping: Record<string, IconName> = {
  'FaUser': 'User',
  'FaBriefcase': 'Building',
  'FaWrench': 'Wrench',
  'FaBlogger': 'PenToSquare',
  'FaFileAlt': 'DownloadFile',
  'FaAddressBook': 'AddressCard',
}

const filteredMenuItems = menuItems.filter(item => item.enabled)
---

<div class={`relative lg:container flex w-full justify-between bg-light-bg-five dark:bg-black py-5 mr-auto ml-auto lg:bg-transparent lg:pl-0 lg:pr-0 lg:pt-[50px] lg:dark:bg-transparent ${className}`}>
  <div class="flex items-center justify-between w-full px-4">
    <a href="/">
      <p class="text-3xl dark:text-white font-jetbrains">
        <span class="font-bold text-codeRed">&lt;RJW</span>.dev/&gt;
      </p>
    </a>
    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        transition:persist="theme-toggle"
        aria-label="Theme toggler"
        type="button"
        class="flex size-[40px] lg:size-[50px] cursor-pointer items-center justify-center rounded-full bg-opacity-100 text-opacity-100 text-black transition-all duration-300 ease-in-out hover:bg-modal-text hover:text-white bg-white dark:hover:bg-modal-text dark:bg-dark-bg-three dark:text-white"
      >
        <span id="theme-toggle-light-icon" class="pointer-events-none dark:hidden">
          <Icon name="Moon" className="text-xl" />
        </span>
        <span id="theme-toggle-dark-icon" class="hidden pointer-events-none dark:block">
          <Icon name="Sun" className="text-xl" />
        </span>
      </button>

      <details class="lg:hidden">
        <summary class="flex h-10 w-10 cursor-pointer items-center justify-center bg-[white] text-[black] hover:bg-modal-text hover:text-white hover:dark:text-white transition-all duration-300 ease-in-out rounded-full dark:text-black list-none" aria-label="Mobile Menu Toggle">
          <span class="menu-open-icon">
            <Icon name="Menu" className="text-xl" />
          </span>
          <span class="menu-close-icon hidden">
            <Icon name="X" className="text-xl" />
          </span>
        </summary>
        <nav class="mobile-menu-nav lg:hidden">
          <ul class="block rounded-b-[20px] shadow-md w-full bg-white dark:bg-dark-mobile-primary">
            {filteredMenuItems.map((item) => {
              const iconName = iconMapping[item.icon] ?? 'Home'
              const isActive = pathname === item.link

              return (
                <li>
                  <a
                    class={`flex cursor-pointer items-center pt-[0.625rem] pb-[0.625rem] pl-4 pr-1 xl:pl-5 xl:pr-5 font-jetbrain text-base sm:text-lg font-medium text-text-primary dark:text-white hover:text-btn-primary transition-all duration-300 ease-in-out ${
                      isActive ? '!text-btn-primary' : ''
                    }`}
                    href={item.link}
                  >
                    <span class="mr-2 text-xl">
                      <Icon name={iconName} />
                    </span>
                    {item.name}
                  </a>
                </li>
              )
            })}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</div>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  
  details[open] .menu-open-icon {
    display: none;
  }
  
  details[open] .menu-close-icon {
    display: block;
  }
  
  .mobile-menu-nav {
    position: absolute;
    left: 0;
    top: 5rem;
    width: 100%;
    max-width: 1052px;
    z-index: 30;
  }
  
  @media (min-width: 1024px) {
    details,
    .mobile-menu-nav {
      display: none;
    }
  }
</style>

<script>
  import { toggleTheme } from '../lib/theme'

  const themeToggle = document.getElementById('theme-toggle')
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      toggleTheme()
    })
  }
</script>
