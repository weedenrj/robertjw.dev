---
import { iconData, type IconName } from '../../lib/icon-data'

interface Props {
  name: IconName
  className?: string
  size?: number | string
}

const { name, className = '', size = 16 } = Astro.props
const icon = iconData[name]

if (!icon) {
  return null
}

const aspectRatio = icon.width / icon.height
const width = typeof size === 'number' ? size : 16
const height = width / aspectRatio
---

{icon && (
  <svg
    width={width}
    height={height}
    viewBox={`0 0 ${icon.width} ${icon.height}`}
    fill="currentColor"
    class={className}
    aria-hidden="true"
  >
    <path d={icon.path} />
  </svg>
)}
