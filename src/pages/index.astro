---
import Layout from "../layouts/Layout.astro"
import { getPersonalInfo, getSkills, getClients } from "../lib/content"
import Sidebar from "../components/Sidebar.astro"
import SkillCard from "../components/SkillCard.astro"
import MainCarousel from "../components/MainCarousel.astro"

const personalInfo = await getPersonalInfo()
const skills = await getSkills()
const clientImages = await getClients()
---

<Layout
  title="RJW | About"
  description="Hey there, I'm a professional web developer with over 4 years of experience across many domains. I enjoy building big projects from small pieces and working with others to create amazing technologies."
>
  <div>
    <div class="px-4 pt-12 md:py-12 sm:px-5 md:px-10 lg:px-14">
      <h2
        class="heading relative inline-block text-[2.5rem] font-bold transform after:absolute after:md:w-[12rem] after:left-[14rem] after:h-0.5 after:bg-gradient-to-r after:from-btn-secondary after:to-btn-secondary after:content-[''] after:rounded-md after:top-2/4 after:transform font-jetbrains"
      >
        About Me
      </h2>
      <div class="lg:hidden">
        <Sidebar personalInfo={personalInfo} />
      </div>
      <div
        class="lg:grid grid-cols-12 md:gap-10 pt-4 md:pt-[30px] items-center hidden"
      >
        <div class="col-span-12 space-y-2.5">
          <div
            class="leading-7 lg:mr-16 text-text-primary dark:text-main-text"
          >
            <p>{personalInfo.body}</p>
          </div>
          <div></div>
        </div>
      </div>
    </div>

    <div class="px-4 pb-12 sm:px-5 md:px-10 lg:px-14">
      <h3
        class="heading text-[35px] font-bold font-robotoSlab pb-5 font-jetbrains"
      >
        What I do!
      </h3>
      <div
        class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-2"
      >
        {skills.map((item) => <SkillCard skill={item} />)}
      </div>
    </div>

    <div class="py-10">
      <div class="flex flex-col max-w-full gap-6 rounded-xl">
        <h3
          class="heading text-center text-[1.75rem] mb-3 font-semibold pt-10 px-2 sm:px-5 md:px-10 lg:px-14"
        >
          Projects
        </h3>
        <MainCarousel clients={clientImages} className="" />
      </div>
    </div>
  </div>
</Layout>
