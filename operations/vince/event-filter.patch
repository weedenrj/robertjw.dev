+
+func TestEventFiltersUseStoredField(t *testing.T) {
+	for _, key := range []string{"event:name", "event:goal"} {
+		t.Run(key, func(t *testing.T) {
+			encoded, err := json.Marshal([]any{[]any{"is", key, []string{"Contact"}}})
+			require.NoError(t, err)
+			q := New(url.Values{"filters": {string(encoded)}})
+			require.Equal(t, Filters{{Op: "is", Key: "event", Value: []string{"Contact"}}}, q.Filter())
+		})
+	}
+	q := New(url.Values{"filters": {`[["is","event:goal",["Visit /resume/"]]]`}})
+	require.Equal(t, Filters{{Op: "is", Key: "page", Value: []string{"/resume/"}}}, q.Filter())
+}
diff --git a/internal/api/aggregates/event_filter_test.go b/internal/api/aggregates/event_filter_test.go
new file mode 100644
index 0000000..905433d
--- /dev/null
+++ b/internal/api/aggregates/event_filter_test.go
@@ -0,0 +1,42 @@
+package aggregates
+
+import (
+	"context"
+	"encoding/json"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"github.com/vinceanalytics/vince/internal/models"
+	"github.com/vinceanalytics/vince/internal/shards"
+	"github.com/vinceanalytics/vince/internal/timeseries"
+	"github.com/vinceanalytics/vince/internal/web/query"
+)
+
+func TestContactFilterExcludesOtherEvents(t *testing.T) {
+	db, err := shards.New(t.TempDir())
+	require.NoError(t, err)
+	defer db.Close()
+	ts := timeseries.New(db, nil)
+	defer ts.Close()
+	when := time.Date(2026, 9, 11, 12, 0, 0, 0, time.UTC)
+	for i, name := range []string{"Contact", "Contact", "OtherEvent"} {
+		require.NoError(t, ts.Add(&models.Model{Domain: []byte("test.example"), Event: []byte(name), Id: uint64(i + 1), Timestamp: when.UnixMilli()}))
+	}
+	require.NoError(t, ts.Save())
+	for _, tc := range []struct {
+		name  string
+		count float64
+	}{{"Contact", 2}, {"OtherEvent", 1}, {"DefinitelyNotARecordedEvent", 0}} {
+		t.Run(tc.name, func(t *testing.T) {
+			filters, err := json.Marshal([]any{[]any{"is", "event:name", []string{tc.name}}})
+			require.NoError(t, err)
+			q := query.New(url.Values{"period": {"custom"}, "from": {"2026-09-11"}, "to": {"2026-09-12"}, "filters": {string(filters)}})
+			s := Aggregates(context.Background(), ts, "test.example", q.Start(), q.End(), q.Interval(), q.Filter(), []string{"events", "visitors"})
+			s.Compute()
+			require.Equal(t, tc.count, s.Events)
+			require.Equal(t, tc.count, s.Visitors)
+		})
+	}
+}
