{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "build:mastra": {
      "dependsOn": [
        "^build:mastra"
      ],
      "outputs": [
        ".mastra/**"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "dev:nextjs": {
      "persistent": true,
      "cache": false
    },
    "dev:mastra": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    }
  }
}